{
  "name": "dldu-points",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm run type-check && pnpm run build-only",
    "preview": "vp preview",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "format": "vp fmt src/"
  },
  "dependencies": {
    "@tsconfig/node26": "26.0.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "8.20.0",
    "lodash-es": "4.18.1",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  }
}
